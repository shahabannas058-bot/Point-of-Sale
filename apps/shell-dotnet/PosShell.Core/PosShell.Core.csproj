<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure logic only: no MAUI, no SQLite, no Windows APIs. That is what lets xUnit run it anywhere. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Warnings are not errors locally; CI runs `dotnet build -warnaserror`. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
